CONTROL_DATABASE_URL=postgresql://syncup:change-me@localhost:5432/syncup_control?schema=public
# Provisioning role: create database privileges. Never use this URL for normal tenant queries.
WORKSPACE_DATABASE_ADMIN_URL=postgresql://syncup_provisioner:change-me@localhost:5432/postgres
# Runtime role: least-privilege credentials, no CREATEDB/superuser. URL database name is replaced by the registry.
WORKSPACE_DATABASE_RUNTIME_URL=postgresql://syncup_runtime:change-me@localhost:5432/postgres
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
AUTH_COOKIE_NAME=syncup_session
POSTGRES_USER=syncup
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=syncup_control
POSTGRES_PORT=5432
