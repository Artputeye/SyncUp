  requestId   String?  @map("request_id") @db.VarChar(128)
  before      Json?
  after       Json?
  metadata    Json?
  occurredAt  DateTime @db.Timestamptz(3) @default(now()) @map("occurred_at")

  @@index([storeId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_logs")
}
