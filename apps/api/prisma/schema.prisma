generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

enum WorkspaceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique @db.VarChar(320)
  passwordHash   String       @map("password_hash")
  displayName    String       @map("display_name") @db.VarChar(160)
  status         UserStatus   @default(ACTIVE)
  isPlatformAdmin Boolean     @default(false) @map("is_platform_admin")
  memberships    Membership[]
  sessions       Session[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model Workspace {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique @db.VarChar(48)
  name        String              @db.VarChar(160)
  status      WorkspaceStatus     @default(PROVISIONING)
  database    WorkspaceDatabase?
  memberships Membership[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("workspaces")
}

model WorkspaceDatabase {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @unique @map("workspace_id") @db.Uuid
  provider      String    @default("postgresql") @db.VarChar(32)
  databaseName  String    @unique @map("database_name") @db.VarChar(63)
  host          String    @db.VarChar(255)
  port          Int
  username      String    @db.VarChar(128)
  secretCipher  String?   @map("secret_cipher") @db.Text
  schemaVersion String?   @map("schema_version") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_databases")
}

model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  isOwner     Boolean  @default(false) @map("is_owner")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  key         String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  isSystem    Boolean          @default(false) @map("is_system")
  memberships MembershipRole[]
  permissions RolePermission[]

  @@unique([workspaceId, key])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(160)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model ModuleInstallation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  moduleId    String   @map("module_id") @db.VarChar(120)
  version     String   @db.VarChar(40)
  enabled     Boolean  @default(false)
  source      String   @default("bundled") @db.VarChar(20)
  installedAt DateTime @default(now()) @map("installed_at")

  @@unique([workspaceId, moduleId])
  @@map("module_installations")
}
